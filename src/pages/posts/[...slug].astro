---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { getPosts, type Post } from "@/utils/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = post.data.published.toISOString().split("T")[0];
const updated = post.data.updated?.toISOString().split("T")[0];
---

<Layout postTitle={post.data.title}>
  <article class="heti">
    <h1 class="page-title">{post.data.title}</h1>
    <div class="post-date">
      <time datetime={published}>{published}</time>
      {updated && <time datetime={updated}>updated {updated}</time>}
    </div>
    <Content />
  </article>
</Layout>
