---
interface Props {
  date: Date;
  updatedDate?: Date;
}

const { date, updatedDate } = Astro.props;
const published = date.toISOString().split("T")[0];
const updated = updatedDate?.toISOString().split("T")[0];
---

<time datetime={published}>{published}</time>
{updated && <time datetime={updated}>updated {updated}</time>}
