---
import type { MarkdownHeading } from 'astro'
import TocIcon from '@/assets/icons/toc-icon.svg'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const filteredHeadings = headings.filter(heading => heading.depth >= 2 && heading.depth <= 4)
---

{filteredHeadings.length > 0 && (
  <>
    <button
      id="toc-button"
      type="button"
      aria-label="Open table of contents"
      aria-haspopup="dialog"
      aria-controls="toc-panel"
      aria-expanded="false"
    >
      <TocIcon aria-hidden="true" fill="currentColor" class="toc-open-icon h-5 w-5" />
      <svg class="toc-close-icon h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    {[false, true].map((mobile) => {
      const Container = mobile ? 'dialog' : 'nav'
      return (
        <Container
          id={mobile ? 'toc-panel' : 'toc-desktop'}
          class:list={[mobile ? 'toc-panel' : 'toc-desktop', 'font-mono']}
          aria-labelledby={mobile ? 'toc-panel-title' : 'toc-desktop-title'}
        >
          <h2 id={mobile ? 'toc-panel-title' : 'toc-desktop-title'}>TREE</h2>
          <ul class="toc-links" id={mobile ? 'toc-mobile-links' : 'toc-links-list'}>
            {filteredHeadings.map(heading => (
              <li style={`--toc-depth: ${heading.depth - 2}`}>
                <a href={`#${heading.slug}`} class="no-heti">
                  <span class="toc-branch" aria-hidden="true">└</span>
                  <span>{heading.text}</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="toc-progress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="toc-progress-track" aria-hidden="true">
              {'░'.repeat(40)}
              <span class="toc-progress-fill">{'█'.repeat(40)}</span>
            </span>
            <span class="toc-progress-percent" aria-hidden="true">00%</span>
          </div>
        </Container>
      )
    })}
  </>
)}

<style>
.toc-desktop {
  display: none;
}

.toc-links {
  margin: 0;
  padding: 0.625rem 0;
  list-style: none;
  -webkit-mask-image: linear-gradient(to bottom, transparent, black 0.625rem, black calc(100% - 0.625rem), transparent);
  mask-image: linear-gradient(to bottom, transparent, black 0.625rem, black calc(100% - 0.625rem), transparent);
  scroll-target-group: auto;
}

.toc-links li + li {
  margin-top: 0.5rem;
}

.toc-links li {
  padding-left: calc(var(--toc-depth) * 2ch);
}

.toc-links a {
  --at-apply: 'flex c-secondary/70 no-underline hover:c-primary';
  gap: 1ch;
  font-size: 0.8125rem;
  overflow-wrap: anywhere;
}

.toc-branch {
  flex-shrink: 0;
  opacity: 0.5;
}

.toc-progress {
  --at-apply: 'c-secondary/50';
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 1ch;
  margin-top: 1rem;
  font-size: 0.75rem;
  line-height: 1;
}

.toc-progress-track {
  position: relative;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.toc-progress-fill {
  --at-apply: 'c-primary';
  position: absolute;
  inset: 0;
  clip-path: inset(0 calc(100% - var(--reading-progress, 0%)) 0 0);
}

.toc-progress-percent {
  width: 4ch;
  text-align: right;
}

.toc-links a:target-current {
  --at-apply: 'c-primary font-medium';
}

#toc-button,
.toc-panel {
  --toc-bottom: calc(1rem + env(safe-area-inset-bottom));
  --toc-right: max(1rem, env(safe-area-inset-right));
  position: fixed;
  right: var(--toc-right);
}

#toc-button {
  --at-apply: 'z-100 grid h-12 w-12 cursor-pointer place-items-center rounded-full border border-solid border-secondary/15 bg-background c-secondary shadow-lg hover:c-primary';
  bottom: var(--toc-bottom);
}

#toc-button .toc-close-icon,
#toc-button[aria-expanded="true"] .toc-open-icon {
  display: none;
}

#toc-button[aria-expanded="true"] .toc-close-icon {
  display: block;
}

.toc-panel {
  --at-apply: 'z-100 rounded-4 border border-solid border-secondary/15 bg-background c-secondary shadow-lg';
  top: auto;
  left: auto;
  bottom: calc(var(--toc-bottom) + 3rem + 0.75rem);
  width: min(22rem, calc(100vw - var(--toc-right) - max(1rem, env(safe-area-inset-left))));
  max-width: none;
  max-height: min(63vh, calc(100vh - var(--toc-bottom) - 3rem - 0.75rem - max(1rem, env(safe-area-inset-top))));
  max-height: min(63dvh, calc(100dvh - var(--toc-bottom) - 3rem - 0.75rem - max(1rem, env(safe-area-inset-top))));
  margin: 0;
  padding: 1rem;
  overflow: hidden;
}

.toc-panel[open] {
  display: flex;
  flex-direction: column;
}

#toc-panel-title,
#toc-desktop-title {
  --at-apply: 'shrink-0 font-semibold c-primary';
  margin-bottom: 0.75rem;
  font-size: 0.75rem;
  letter-spacing: 0.1em;
}

.toc-panel .toc-links {
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.toc-panel .toc-links a {
  padding-block: 0.5rem;
}

@media (min-width: 1024px) {
  #toc-button {
    display: none;
  }

  .toc-desktop {
    display: flex;
    flex-direction: column;
    height: 82%;
  }

  .toc-desktop .toc-links {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .toc-desktop a {
    font-size: 0.75rem;
  }
}
</style>

<script>
const desktop = window.matchMedia('(min-width: 1024px)')
let cleanup: (() => void) | undefined

function setupTOC() {
  cleanup?.()
  const trigger = document.getElementById('toc-button')
  const panel = document.getElementById('toc-panel')
  const list = document.getElementById('toc-links-list')
  const content = document.getElementById('post-content')
  if (!trigger || !(panel instanceof HTMLDialogElement) || !list || !content) {
    return
  }

  const controller = new AbortController()
  const { signal } = controller
  let frame: number | undefined
  let progressFrame: number | undefined
  let lastLink: Element | null = null
  const progressBars = document.querySelectorAll<HTMLElement>('.toc-progress')

  function updateProgress() {
    if (!content) {
      return
    }
    const bounds = content.getBoundingClientRect()
    // Start when the article reaches its heading offset; finish when its end is visible.
    const start = bounds.top + window.scrollY - 80
    const end = bounds.bottom + window.scrollY - window.innerHeight
    const fraction = end > start
      ? (window.scrollY - start) / (end - start)
      : bounds.bottom <= window.innerHeight ? 1 : 0
    const percent = Math.round(Math.min(1, Math.max(0, fraction)) * 100)
    for (const bar of progressBars) {
      bar.setAttribute('aria-valuenow', String(percent))
      bar.style.setProperty('--reading-progress', `${percent}%`)
      const label = bar.querySelector('.toc-progress-percent')
      if (label) {
        label.textContent = `${String(percent).padStart(2, '0')}%`
      }
    }
  }

  function scheduleProgress() {
    if (progressFrame !== undefined) {
      return
    }
    progressFrame = requestAnimationFrame(() => {
      progressFrame = undefined
      updateProgress()
    })
  }

  document.addEventListener('scroll', scheduleProgress, { passive: true, signal })
  window.addEventListener('resize', scheduleProgress, { signal })
  const resizeObserver = new ResizeObserver(scheduleProgress)
  resizeObserver.observe(content)
  resizeObserver.observe(document.documentElement)
  scheduleProgress()

  function syncTrigger() {
    const open = panel instanceof HTMLDialogElement && panel.open
    trigger?.setAttribute('aria-expanded', String(open))
    trigger?.setAttribute('aria-label', open ? 'Close table of contents' : 'Open table of contents')
  }

  function closePanel() {
    if (panel instanceof HTMLDialogElement && panel.open) {
      panel.close()
      syncTrigger()
    }
  }

  trigger.addEventListener('click', () => {
    if (desktop.matches) {
      return
    }
    if (panel.open) {
      closePanel()
    }
    else {
      panel.show()
      syncTrigger()
      trigger.focus({ preventScroll: true })
    }
  }, { signal })
  panel.addEventListener('close', syncTrigger, { signal })
  panel.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a[href^="#"]')) {
      closePanel()
    }
  }, { signal })
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !panel.contains(event.target) && !trigger.contains(event.target)) {
      closePanel()
    }
  }, { signal })
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel.open) {
      event.preventDefault()
      closePanel()
      trigger.focus({ preventScroll: true })
    }
  }, { signal })
  desktop.addEventListener('change', () => {
    if (desktop.matches) {
      closePanel()
    }
  }, { signal })

  if (CSS.supports('selector(:target-current)')) {
    document.addEventListener('scroll', () => {
      if (!desktop.matches || frame !== undefined) {
        return
      }
      // Native :target-current selection settles after the scroll frame is painted.
      frame = requestAnimationFrame(() => {
        frame = requestAnimationFrame(() => {
          frame = undefined
          const activeLink = list.querySelector('a:target-current')
          if (activeLink && activeLink !== lastLink) {
            const bounds = list.getBoundingClientRect()
            const linkBounds = activeLink.getBoundingClientRect()
            const style = getComputedStyle(list)
            const top = bounds.top + Number.parseFloat(style.paddingTop)
            const bottom = bounds.bottom - Number.parseFloat(style.paddingBottom)
            // Keep the active link clear of the fades without moving the article.
            if (linkBounds.top < top) {
              list.scrollTop += linkBounds.top - top
            }
            else if (linkBounds.bottom > bottom) {
              list.scrollTop += linkBounds.bottom - bottom
            }
            lastLink = activeLink
          }
        })
      })
    }, { passive: true, signal })
  }

  cleanup = () => {
    closePanel()
    controller.abort()
    resizeObserver.disconnect()
    if (frame !== undefined) {
      cancelAnimationFrame(frame)
    }
    if (progressFrame !== undefined) {
      cancelAnimationFrame(progressFrame)
    }
  }
}

document.addEventListener('astro:page-load', setupTOC)
document.addEventListener('astro:before-swap', () => {
  cleanup?.()
  cleanup = undefined
})
</script>
