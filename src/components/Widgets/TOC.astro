---
import type { MarkdownHeading } from 'astro'
import TocIcon from '@/assets/icons/toc-icon.svg'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const filteredHeadings = headings.filter(heading => heading.depth >= 2 && heading.depth <= 4)
---

{filteredHeadings.length > 0 && (
  <>
    <button
      id="toc-button"
      type="button"
      aria-label="Open table of contents"
      aria-haspopup="dialog"
      aria-controls="toc-sheet"
      aria-expanded="false"
    >
      <TocIcon aria-hidden="true" fill="currentColor" class="h-5 w-5" />
    </button>
    {[false, true].map((mobile) => {
      const Container = mobile ? 'dialog' : 'nav'
      return (
        <Container
          id={mobile ? 'toc-sheet' : 'toc-desktop'}
          class={mobile ? 'toc-sheet' : 'toc-desktop'}
          aria-labelledby={mobile ? 'toc-sheet-title' : 'toc-desktop-title'}
        >
          {!mobile && <h2 id="toc-desktop-title">Table of Contents</h2>}
          {mobile && (
            <header class="toc-sheet-header">
              <h2 id="toc-sheet-title">Table of Contents</h2>
              <button id="toc-close" type="button" aria-label="Close table of contents">×</button>
            </header>
          )}
          <ul class="toc-links" id={mobile ? 'toc-mobile-links' : 'toc-links-list'}>
            {filteredHeadings.map(heading => (
              <li class:list={{ 'ml-4': heading.depth === 3, 'ml-8': heading.depth === 4 }}>
                <a href={`#${heading.slug}`} class="no-heti">{heading.text}</a>
              </li>
            ))}
          </ul>
        </Container>
      )
    })}
  </>
)}

<style>
.toc-desktop {
  display: none;
}

.toc-links {
  margin: 0;
  padding: 0.625rem 0;
  list-style: none;
  -webkit-mask-image: linear-gradient(to bottom, transparent, black 0.625rem, black calc(100% - 0.625rem), transparent);
  mask-image: linear-gradient(to bottom, transparent, black 0.625rem, black calc(100% - 0.625rem), transparent);
  scroll-target-group: auto;
}

.toc-links li + li {
  margin-top: 0.5rem;
}

.toc-links a {
  --at-apply: 'block c-secondary/70 no-underline hover:c-primary';
  font-size: 0.8125rem;
  overflow-wrap: anywhere;
}

.toc-links a:target-current {
  --at-apply: 'c-primary font-medium';
}

#toc-button {
  --at-apply: 'fixed z-100 grid h-12 w-12 cursor-pointer place-items-center rounded-full border border-solid border-secondary/15 bg-background c-secondary shadow-lg hover:c-primary';
  right: max(1rem, env(safe-area-inset-right));
  bottom: calc(1rem + env(safe-area-inset-bottom));
}

.toc-sheet {
  --at-apply: 'border-none rounded-t-4 bg-background c-secondary';
  position: fixed;
  inset: auto 0 0;
  width: 100%;
  max-width: 100%;
  max-height: 63vh;
  max-height: 63dvh;
  margin: 0;
  padding: 1rem max(1.25rem, env(safe-area-inset-right)) calc(1.25rem + env(safe-area-inset-bottom)) max(1.25rem, env(safe-area-inset-left));
  overflow: hidden;
}

.toc-sheet[open] {
  display: flex;
  flex-direction: column;
}

.toc-sheet::backdrop {
  background: rgb(0 0 0 / 40%);
}

.toc-sheet-header {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 0.75rem;
}

.toc-sheet-header h2 {
  --at-apply: 'font-semibold c-primary';
}

#toc-close {
  --at-apply: 'h-11 w-11 shrink-0 cursor-pointer text-6 hover:c-primary';
}

.toc-sheet .toc-links {
  overflow-y: auto;
  overscroll-behavior: contain;
}

.toc-sheet .toc-links a {
  padding-block: 0.5rem;
}

@media (min-width: 1024px) {
  #toc-button {
    display: none;
  }

  .toc-desktop {
    display: flex;
    flex-direction: column;
    height: 82%;
  }

  #toc-desktop-title {
    --at-apply: 'shrink-0 font-semibold c-secondary/90';
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
  }

  .toc-desktop .toc-links {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .toc-desktop a {
    font-size: 0.75rem;
  }
}
</style>

<script>
const desktop = window.matchMedia('(min-width: 1024px)')
let cleanup: (() => void) | undefined

function setupTOC() {
  cleanup?.()
  const trigger = document.getElementById('toc-button')
  const sheet = document.getElementById('toc-sheet')
  const closeButton = document.getElementById('toc-close')
  const list = document.getElementById('toc-links-list')
  if (!trigger || !(sheet instanceof HTMLDialogElement) || !closeButton || !list) {
    return
  }

  const controller = new AbortController()
  const { signal } = controller
  let previousOverflow: string | undefined
  let frame: number | undefined
  let lastLink: Element | null = null

  function restoreScroll() {
    if (previousOverflow !== undefined) {
      document.body.style.overflow = previousOverflow
      previousOverflow = undefined
    }
    trigger?.setAttribute('aria-expanded', 'false')
  }

  function closeSheet() {
    if (sheet instanceof HTMLDialogElement && sheet.open) {
      sheet.close()
      restoreScroll()
    }
  }

  trigger.addEventListener('click', () => {
    if (desktop.matches || sheet.open) {
      return
    }
    sheet.showModal()
    previousOverflow = document.body.style.overflow
    document.body.style.overflow = 'hidden'
    trigger.setAttribute('aria-expanded', 'true')
  }, { signal })
  closeButton.addEventListener('click', closeSheet, { signal })
  sheet.addEventListener('close', restoreScroll, { signal })
  sheet.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a[href^="#"]')) {
      closeSheet()
    }
    else if (event.target === sheet) {
      const bounds = sheet.getBoundingClientRect()
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
        closeSheet()
      }
    }
  }, { signal })
  desktop.addEventListener('change', () => {
    if (desktop.matches) {
      closeSheet()
    }
  }, { signal })

  if (CSS.supports('selector(:target-current)')) {
    document.addEventListener('scroll', () => {
      if (!desktop.matches || frame !== undefined) {
        return
      }
      // Native :target-current selection settles after the scroll frame is painted.
      frame = requestAnimationFrame(() => {
        frame = requestAnimationFrame(() => {
          frame = undefined
          const activeLink = list.querySelector('a:target-current')
          if (activeLink && activeLink !== lastLink) {
            const bounds = list.getBoundingClientRect()
            const linkBounds = activeLink.getBoundingClientRect()
            const style = getComputedStyle(list)
            const top = bounds.top + Number.parseFloat(style.paddingTop)
            const bottom = bounds.bottom - Number.parseFloat(style.paddingBottom)
            // Keep the active link clear of the fades without moving the article.
            if (linkBounds.top < top) {
              list.scrollTop += linkBounds.top - top
            }
            else if (linkBounds.bottom > bottom) {
              list.scrollTop += linkBounds.bottom - bottom
            }
            lastLink = activeLink
          }
        })
      })
    }, { passive: true, signal })
  }

  cleanup = () => {
    closeSheet()
    restoreScroll()
    controller.abort()
    if (frame !== undefined) {
      cancelAnimationFrame(frame)
    }
  }
}

document.addEventListener('astro:page-load', setupTOC)
document.addEventListener('astro:before-swap', () => {
  cleanup?.()
  cleanup = undefined
})
</script>
