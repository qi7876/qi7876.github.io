---
import { base } from "@/config";
import { getPageInfo } from "@/utils/page";

const { isHome, isPost, isAbout } = getPageInfo(Astro.url.pathname);

const isPostActive = isHome || isPost;
const isAboutActive = isAbout;

const navItems = [
  {
    href: "/",
    label: "Posts",
    isActive: isPostActive,
  },
  {
    href: "/about/",
    label: "About",
    isActive: isAboutActive,
  },
];
---

<nav
  aria-label="Site Navigation"
  class="mb-6 text-3.6 font-semibold leading-2.45em font-navbar lg:text-4"
>
  <ul>
    {navItems.map((item) => (
      <li>
        <a
          href={`${base}${item.href}`}
          class:list={{ underline: item.isActive }}
          aria-current={item.isActive ? "page" : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
