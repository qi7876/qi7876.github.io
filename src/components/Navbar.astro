---
const path = Astro.url.pathname.replace(/\/$/, "");
const isPostActive = path === "" || path.startsWith("/posts/");
const isAboutActive = path === "/about";

const navItems = [
  {
    href: "/",
    label: "Posts",
    isActive: isPostActive,
  },
  {
    href: "/about/",
    label: "About",
    isActive: isAboutActive,
  },
];
---

<nav aria-label="Site Navigation" class="site-nav">
  <ul>
    {navItems.map((item) => (
      <li>
        <a href={item.href} aria-current={item.isActive ? "page" : undefined}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
