---
import { base } from "@/config";
import { getPageInfo } from "@/utils/page";

const { isHome, isPost, isAbout } = getPageInfo(Astro.url.pathname);

const isPostActive = isHome || isPost;
const isAboutActive = isAbout;

const navItems = [
  {
    href: "/",
    label: "Posts",
    isActive: isPostActive,
  },
  {
    href: "/about/",
    label: "About",
    isActive: isAboutActive,
  },
];
---

<nav aria-label="Site Navigation" class="site-nav">
  <ul>
    {navItems.map((item) => (
      <li>
        <a href={`${base}${item.href}`} aria-current={item.isActive ? "page" : undefined}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
