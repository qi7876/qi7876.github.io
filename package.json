{
  "name": "qi7876.github.io",
  "version": "1.0.0",
  "repository": "https://github.com/qi7876/qi7876.github.io",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && oxlint . --deny-warnings && oxfmt --check . && lint-md \"**/*.md\"",
    "format": "oxfmt --write . && lint-md \"**/*.md\" --fix"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/partytown": "^2.1.8",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "astro-compress": "^2.4.3",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "^0.5.2",
    "@lint-md/cli": "^2.4.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --write"
    ],
    "*.md": [
      "oxfmt --write",
      "lint-md --fix"
    ],
    "*.{astro,json,jsonc,json5,css,scss,less,yaml,yml,toml,html,graphql,gql}": "oxfmt --write"
  },
  "packageManager": "pnpm@12.6.0"
}
