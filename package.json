{
  "name": "qi7876.github.io",
  "version": "1.0.0",
  "repository": "https://github.com/qi7876/qi7876.github.io",
  "type": "module",
  "scripts": {
    "dev": "astro check && astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "pnpm build && tsx --test tests/**/*.test.ts",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format:posts": "oxfmt --write \"src/content/{posts,about}/**/*.md\" && lint-md \"src/content/{posts,about}/**/*.md\" --fix",
    "format": "oxfmt --write . && lint-md \"**/*.md\" --fix",
    "format:check": "oxfmt --check . && lint-md \"**/*.md\"",
    "check": "pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/partytown": "^2.1.8",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "astro-compress": "^2.4.3",
    "feed": "^6.0.0",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "mdast-util-to-string": "^4.0.0",
    "node-html-parser": "^9.0.4",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "^0.5.2",
    "@lint-md/cli": "^2.4.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "@types/sanitize-html": "^2.16.1",
    "@unocss/astro": "66.10.5",
    "@unocss/preset-attributify": "66.10.5",
    "@unocss/reset": "66.10.5",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unocss": "66.10.5",
    "unocss-preset-theme": "^0.14.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --write"
    ],
    "*.md": [
      "oxfmt --write",
      "lint-md --fix"
    ],
    "*.{astro,json,jsonc,json5,css,scss,less,yaml,yml,toml,html,graphql,gql}": "oxfmt --write"
  },
  "packageManager": "pnpm@12.6.0"
}
